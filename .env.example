# ==============================================================================
# LEAD GENERATION AUTOMATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (SQLite Local)
DATABASE_URL="file:./dev.db"

# Environment & Logging
NODE_ENV="development"
LOG_LEVEL="info"

# Global Safety & Dry-Run Controls (Conservative Defaults)
# Global Dry-Run flag: when true, no external actions, emails, or destructive operations occur.
DRY_RUN=true

# Automation batch and rate safety limits
MAX_ITEMS_PER_RUN=10
REQUEST_DELAY_MS=2000
MAX_RETRIES=3
COOLDOWN_MS=5000
MAX_EMAILS_PER_RUN=5

# ==============================================================================
# DISCOVERY SOURCE SAFETY CONTROLS & KILL SWITCHES (PHASE 2.5)
# ==============================================================================

# Source Kill Switches
DISCOVERY_OSM_ENABLED=true
DISCOVERY_DDG_ENABLED=true

# Custom Identification User-Agent for compliant public API / search usage
DISCOVERY_USER_AGENT="LeadGenAutomation/0.2.0 (Public Research; https://github.com)"

# Source Request Budgets & Delays (Application-level conservative throttling)
MAX_SOURCE_REQUESTS_PER_RUN=20
SOURCE_MAX_REQUESTS_PER_RUN=10
SOURCE_MIN_DELAY_MS=1500
SOURCE_MAX_RETRIES=1

# ==============================================================================
# FUTURE MODULE CONFIGURATION PLACEHOLDERS (NOT REQUIRED FOR PHASE 2)
# ==============================================================================

# Gmail API OAuth Credentials (Future Phase)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/oauth2callback"

# AI Provider Configuration (Future Phase - e.g. Gemini / Groq / OpenAI)
AI_PROVIDER=""
AI_API_KEY=""
