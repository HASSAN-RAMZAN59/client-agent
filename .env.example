# ==============================================================================
# LEAD GENERATION AUTOMATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (SQLite Local)
DATABASE_URL="file:./dev.db"

# Environment & Logging
NODE_ENV="development"
LOG_LEVEL="info"

# Global Safety & Dry-Run Controls (Conservative Defaults)
# Global Dry-Run flag: when true, no external network dispatches, emails, or destructive operations occur.
DRY_RUN=true
OUTREACH_ENABLED=false

# Automation batch and rate safety limits
MAX_ITEMS_PER_RUN=10
REQUEST_DELAY_MS=2000
MAX_RETRIES=3
COOLDOWN_MS=5000
MAX_EMAILS_PER_RUN=5
MAX_EMAILS_PER_DAY=20

# Outreach Hardening, Cooldowns & Spacing (Phase 6.5 & Phase 7)
OUTREACH_BUSINESS_COOLDOWN_DAYS=30
OUTREACH_CONTACT_COOLDOWN_DAYS=30
OUTREACH_DRAFT_EXPIRATION_DAYS=14
OUTREACH_MIN_DELAY_MS=3000
OUTREACH_COOLDOWN_MS=5000

# ==============================================================================
# DISCOVERY SOURCE SAFETY CONTROLS & KILL SWITCHES (PHASE 2.5)
# ==============================================================================

# Source Kill Switches
DISCOVERY_OSM_ENABLED=true
DISCOVERY_DDG_ENABLED=true

# Custom Identification User-Agent for compliant public API / search usage
DISCOVERY_USER_AGENT="LeadGenAutomation/0.2.0 (Public Research; https://github.com)"

# Source Request Budgets & Delays (Application-level conservative throttling)
MAX_SOURCE_REQUESTS_PER_RUN=20
SOURCE_MAX_REQUESTS_PER_RUN=10
SOURCE_MIN_DELAY_MS=1500
SOURCE_MAX_RETRIES=1

# ==============================================================================
# ZERO-COST SMTP DELIVERY TRANSPORT CONFIGURATION (PHASE 7)
# ==============================================================================

# Standard configuration-driven SMTP credentials (safe placeholders)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Alex Morgan"
SMTP_FROM_EMAIL="alex@modernwebstudio.com"

# ==============================================================================
# FUTURE MODULE CONFIGURATION PLACEHOLDERS (NOT REQUIRED FOR PHASES 1-7)
# ==============================================================================

# Gmail API OAuth Credentials (Future Phase)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/oauth2callback"

# AI Provider Configuration (Optional local or cloud model)
AI_PROVIDER=""
AI_API_KEY=""
